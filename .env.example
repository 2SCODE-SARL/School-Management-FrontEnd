# URL utilisée par le frontend dans le navigateur pour appeler l'API.
# En dev : relative ("/api") pour passer par le proxy Vite ci-dessous et éviter
# le blocage CORS du backend staging (qui n'autorise pas localhost).
# En prod (une fois le backend déployé avec le bon CORS) : mettre l'URL complète.
VITE_API_BASE_URL=/api

# Cible réelle vers laquelle le proxy de dev (vite.config.js) redirige /api.
VITE_API_PROXY_TARGET=https://gestion-ecoles-backend-staging-v1.onrender.com
